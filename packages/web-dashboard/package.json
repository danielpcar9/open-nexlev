{
  "name": "@open-nexlev/web-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "start": "next start",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:push": "drizzle-kit push",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/db/*.test.ts src/http/*.test.ts src/services/*.test.ts src/components/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 src/integration/*.test.ts"
  },
  "dependencies": {
    "@open-nexlev/niche-engine": "*",
    "better-sqlite3": "^11.1.2",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "youtubei.js": "^18.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.5.0",
    "tsx": "^4.15.0"
  }
}
