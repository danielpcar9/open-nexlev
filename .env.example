# Ruta del archivo SQLite. Si es relativa, se resuelve contra packages/web-dashboard,
# no contra el directorio desde el que se lanzó el proceso.
DATABASE_URL=./open-nexlev.db
PORT=3000
# ALLOWED_HOSTS=mi-host.local:3000
# OBSERVATION_RETENTION_DAYS=35
# PROVIDER_CONCURRENCY=2
# YOUTUBE_API_KEY=
# Activa el proveedor oficial solo después de leer la política vigente.
# El valor exacto aplica borrado a los 30 días y no puede ampliarse con OBSERVATION_RETENTION_DAYS.
# YOUTUBE_API_STORAGE_ACK=30-days
